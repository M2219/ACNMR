<?xml version="1.0" encoding="utf-8"?>
<robot name="ackermann_drive" xmlns:xacro="http://ros.org/wiki/xacro">
  <link name="base_link" />

  <!-- chassis -->
  <link name="chassis">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <mass
        value="10" />
      <inertia
        ixx="0.0332370959804736"
        ixy="-1.013150489971E-06"
        ixz="-0.00188859201421112"
        iyy="0.111072002332437"
        iyz="-5.13308150598312E-07"
        izz="0.12660862809283" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find ign_ros2_control_demos)/meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find ign_ros2_control_demos)/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- chassis_joint -->
  <joint name="chassis_joint" type="fixed">
    <origin xyz="0.0266989327622036 0.000409203500587652 0.4" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="chassis" />
  </joint>

  <!-- front_steer_left_link -->
  <link
    name="front_steer_left_link">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <mass
        value="0.5" />
      <inertia
        ixx="0.0222"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0222"
        iyz="0.0"
        izz="0.0222" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- front_steer_left_joint -->
  <joint
    name="front_steer_left_joint"
    type="revolute">
    <origin
      xyz="0.37142 0.3025 -0.1955"
      rpy="1.5708 0 0" />
    <parent
      link="chassis" />
    <child
      link="front_steer_left_link" />
    <axis
      xyz="0 1 0" />
    <dynamics damping="0.2" />
    <limit effort="1000.0" lower="-1.57" upper="1.57" velocity="30"/>
  </joint>

  <!-- front_left_wheel_link  -->
  <link
    name="front_left_wheel_link">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <mass
        value="1" />
      <inertia
        ixx="0.063724"
        ixy="0"
        ixz="0"
        iyy="0.063724"
        iyz="0"
        izz="0.11072" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find ign_ros2_control_demos)/meshes/front_left_wheel_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0 0 0 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.165" length="0.14"/>
      </geometry>
    </collision>
  </link>

  <!-- front_left_wheel_joint -->
  <joint
    name="front_left_wheel_joint"
    type="continuous">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="front_steer_left_link" />
    <child
      link="front_left_wheel_link" />
    <axis
      xyz="0 0 1" />
  </joint>

  <!-- front_steer_right_link -->
  <link
    name="front_steer_right_link">
    <inertial>
      <origin
        xyz="0.0 0.0 0.0"
        rpy="0 0 0" />
      <mass
        value="0.5" />
      <inertia
        ixx="0.0222"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0222"
        iyz="0.0"
        izz="0.0222" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <!-- front_steer_right_joint  -->
  <joint
    name="front_steer_right_joint"
    type="revolute">
    <origin
      xyz="0.37142 -0.3025 -0.1955"
      rpy="1.5708 0 0" />
    <parent
      link="chassis" />
    <child
      link="front_steer_right_link" />
    <axis
      xyz="0 1 0" />
    <dynamics damping="0.2" />
    <limit effort="1000.0" lower="-1.57" upper="1.57" velocity="30"/>
  </joint>

  <!-- front_right_wheel_link  -->
  <link
    name="front_right_wheel_link">
    <inertial>
      <origin
        xyz="0.0 0.0 0.0"
        rpy="0 0 0" />
      <mass
        value="1" />
      <inertia
        ixx="0.063724"
        ixy="0"
        ixz="0"
        iyy="0.063724"
        iyz="0"
        izz="0.11072" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 3.14 0" />
      <geometry>
        <mesh
          filename="file://$(find ign_ros2_control_demos)/meshes/front_left_wheel_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0 0 0 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.165" length="0.14"/>

      </geometry>
    </collision>
  </link>

  <!-- front_right_wheel_joint  -->
  <joint
    name="front_right_wheel_joint"
    type="continuous">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="front_steer_right_link" />
    <child
      link="front_right_wheel_link" />
    <axis
      xyz="0 0 1" />
  </joint>

  <!-- rear_left_link  -->
  <link
    name="rear_left_link">
    <inertial>
      <origin
        xyz="0.0 0.0 0.0"
        rpy="0 0 0" />
      <mass
        value="1" />
      <inertia
        ixx="0.063724"
        ixy="0"
        ixz="0"
        iyy="0.063724"
        iyz="0"
        izz="0.11072" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find ign_ros2_control_demos)/meshes/left_rear_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0 0 0 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.165" length="0.14"/>
      </geometry>
    </collision>
  </link>

  <!-- rear_left_joint  -->
  <joint
    name="rear_left_joint"
    type="continuous">
    <origin
      xyz="-0.28 0.3025 -0.19558"
      rpy="1.5708 0 0" />
    <parent
      link="chassis" />
    <child
      link="rear_left_link" />
    <axis
      xyz="0 0 -1" />
  </joint>

  <!-- rear_right_link  -->
  <link
    name="rear_right_link">
    <inertial>
      <origin
        xyz="0.0 0.0 0.0"
        rpy="0 0 0" />
      <mass
        value="1" />
      <inertia
        ixx="0.063724"
        ixy="0"
        ixz="0"
        iyy="0.063724"
        iyz="0"
        izz="0.11072" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find ign_ros2_control_demos)/meshes/right_rear_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0 0 0 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
         <cylinder radius="0.165" length="0.14"/>

      </geometry>
    </collision>
  </link>

  <!-- rear_right_joint -->
  <joint
    name="rear_right_joint"
    type="continuous">
    <origin
      xyz="-0.28018 -0.3025 -0.19558"
      rpy="1.5708 0 0" />
    <parent
      link="chassis" />
    <child
      link="rear_right_link" />
    <axis
      xyz="0 0 -1" />
  </joint>

<ros2_control name="IgnitionSystem" type="system">
  <hardware>
    <plugin>ign_ros2_control/IgnitionSystem</plugin>
  </hardware>

  <joint name="rear_left_joint">
    <command_interface name="velocity"/>
    <state_interface name="velocity"/>
    <state_interface name="position"/>
  </joint>

  <joint name="rear_right_joint">
    <command_interface name="velocity"/>
    <state_interface name="velocity"/>
    <state_interface name="position"/>
  </joint>

  <joint name="front_steer_left_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>

  <joint name="front_steer_right_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
  </joint>
</ros2_control>

  <gazebo>
    <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(find ign_ros2_control_demos)/config/ackermann_drive_controller.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
