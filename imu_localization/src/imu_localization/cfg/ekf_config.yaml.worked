ekf_filter_node:
  ros__parameters:
    sensor_timeout: 0.0
    frequency: 10.0
    two_d_mode: true
    publish_tf: false
    world_frame: "odom"
    odom_frame: "odom" # for fusion the wheel odometry should publish to a custom frame id like wheel_odom then localization wheel pulish wheel_odom to base_link
    base_link_frame: "base_link"

    #        [x_pos   , y_pos    , z_pos,
    #         roll    , pitch    , yaw,
    #         x_vel   , y_vel    , z_vel,
    #         roll_vel, pitch_vel, yaw_vel,
    #         x_accel , y_accel  , z_accel]

    #robot
    odom0: "/ov_msckf/loop_pose"
    #odom0: "/ov_msckf/odomimu"

    odom0_config: [true, true, false,
                   false, false, true,
                   false, false, false,
                   false, false, false,
                   false, false, false]

    odom0_nodelay: false
    odom0_differential: false
    odom0_queue_size: 1
    odom0_relative: false


    dynamic_process_noise_covariance: false

    print_diagnostics: false
    debug: false

